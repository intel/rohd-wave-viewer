{
    "version": "0.2.0",
    "configurations": [
        // ============================================================
        // Extension configurations
        // ============================================================
        {
            "name": "Extension (workspace)",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
                "--user-data-dir=${workspaceFolder}/.vscode-test-user-data"
            ],
            "outFiles": [
                "${workspaceFolder}/vscode-extension/out/**/*.js"
            ],
            "preLaunchTask": "Build Extension",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "Extension (workspace) + Debug",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "runtimeArgs": [
                "--nolazy",
                "--inspect-brk=9329"
            ],
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
                "--user-data-dir=${workspaceFolder}/.vscode-test-user-data"
            ],
            "outFiles": [
                "${workspaceFolder}/vscode-extension/out/**/*.js"
            ],
            "preLaunchTask": "Build Extension",
            "internalConsoleOptions": "openOnSessionStart"
        },
        // ============================================================
        // Web configurations
        // ============================================================
        {
            "name": "Web (Simple Browser)",
            "program": "lib/main_web.dart",
            "request": "launch",
            "type": "dart",
            "deviceId": "web-server",
            "args": [
                "--web-port=9299",
                "--web-hostname=localhost"
            ]
        },
        {
            "name": "Web (Chrome)",
            "program": "lib/main_web.dart",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome"
        },
        // ============================================================
        // Linux Native configurations
        // ============================================================
        {
            "name": "Linux Native",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "deviceId": "linux"
        },
        {
            "name": "Linux Native (profile)",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "deviceId": "linux",
            "flutterMode": "profile"
        }
    ]
}